{
  "expo": {
    "name": "Pear Wallpaper",
    "slug": "pear-wallpaper",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "scheme": "to.holepunch.bare.expo",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "to.holepunch.bare.expo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pearwallpaper.app"
    },
    "plugins": [
      ["expo-router"],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pear Wallpaper to access your camera to scan an invite QR code.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withGradleJvmFix"
    ]
  }
}
