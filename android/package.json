{
  "private": true,
  "name": "bare-expo",
  "description": "Example of embedding Bare in an Expo application",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "npm run bundle:worklet && expo run:android",
    "ios": "expo run:ios",
    "postinstall": "patch-package",
    "test:ui": "jest",
    "test:worklet": "brittle test-worklet/*.test.js",
    "bundle:worklet": "bare-pack --linked --host android-arm64 --host android-x64 --out app/gen/worklet.bundle.mjs worklet/core-host.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-expo.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-expo/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-expo#readme",
  "dependencies": {
    "@paulmillr/qr": "0.2.1",
    "b4a": "1.8.1",
    "expo": "55.0.23",
    "expo-background-task": "55.0.21",
    "expo-build-properties": "55.0.13",
    "expo-camera": "55.0.22",
    "expo-constants": "55.0.16",
    "expo-device": "55.0.20",
    "expo-file-system": "55.0.25",
    "expo-linking": "55.0.15",
    "expo-router": "55.0.14",
    "expo-share-intent": "6.1.1",
    "expo-system-ui": "55.0.17",
    "expo-task-manager": "55.0.19",
    "pear-wallpaper-bridge": "file:../bridge",
    "pear-wallpaper-core": "file:../core",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-b4a": "0.0.4",
    "react-native-bare-kit": "0.15.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/react": "19.2.14",
    "bare-pack": "2.2.1",
    "brittle": "3.19.1",
    "jest": "29.7.0",
    "jest-expo": "55.0.21",
    "patch-package": "8.0.1",
    "prettier": "3.8.3",
    "prettier-config-holepunch": "2.0.0",
    "test-tmp": "1.4.0",
    "typescript": "5.9.3"
  }
}
